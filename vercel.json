{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "web",
  "headers": [
    {
      "source": "/pkg/(.*).wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "visual-bitcoin-engine.vercel.app" }],
      "destination": "https://howbitcoinworks.dev/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "visual-bitcoin-engine.vercel.app" }],
      "destination": "https://howbitcoinworks.dev/:path*",
      "permanent": true
    }
  ]
}
